# Backend base URL (REST + MCP). Per backend-handoff.md the backend runs on
# port 4000; the frontend runs on port 80 in production and 3000 in dev.
NEXT_PUBLIC_API_URL=http://couchcollective.software:4000

# Keep the in-memory mock (the stub) until the real backend is live.
# Flip to false, or remove this line, once the backend is reachable.
NEXT_PUBLIC_USE_MOCK=true
